# Applied only to environments using framework = espidf; the Arduino-only envs
# ignore this file. Kept to the minimum that an Arduino-as-component build
# actually requires, so a failure here means something real.

# esp32-arduino refuses to configure below 1000 Hz, and the IDF default is 100.
CONFIG_FREERTOS_HZ=1000

# Without this the Arduino core never starts, setup()/loop() are never called,
# and the build wants an app_main() the sketch does not define.
CONFIG_AUTOSTART_ARDUINO=y

# Match the 4 MB layout partitions.csv is written against.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
